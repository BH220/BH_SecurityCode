<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  대상 기기: 삼성 갤럭시 A35 5G (SM-A356)
	    - SoC       : Exynos 1380 (ARM 64bit 전용) → android-arm64
	    - OS        : Android 14(API 34) 출고, Android 15(API 35) 이상 업데이트 지원
	    - 화면      : 6.6" 1080 x 2340 (19.5:9), 약 450dpi → 논리 크기 약 384 x 832 dp
	    - 방향      : 세로 고정 (MainActivity.cs)
	-->
	<PropertyGroup>
		<TargetFramework>net9.0-android35.0</TargetFramework>
		<!-- A35 출고 OS인 Android 14를 최소 지원 버전으로 둔다. 구형 기기까지 지원하려면 이 값을 낮춘다. -->
		<SupportedOSPlatformVersion>34.0</SupportedOSPlatformVersion>
		<!-- 실기기(A35)는 arm64. Debug 에서는 PC 에뮬레이터용 x86_64 도 함께 넣어 같은 APK 로 양쪽에 배포한다. -->
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(Configuration)' == 'Debug'">android-arm64;android-x64</RuntimeIdentifiers>

		<OutputType>Exe</OutputType>
		<RootNamespace>BH_SecurityCode.Mobile</RootNamespace>
		<AssemblyName>BH_SecurityCode.Mobile</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>ko-KR</NeutralLanguage>
		<NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8625;CS8600</NoWarn>

		<!-- 컴파일된 바인딩을 소스 생성으로 처리 (리플렉션 제거, 시작 속도 개선) -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- 표시 이름 -->
		<ApplicationTitle>BH 보안코드</ApplicationTitle>

		<!-- 패키지 ID -->
		<ApplicationId>com.bhsoft.securitycode</ApplicationId>

		<!--
		  버전. ApplicationVersion 이 안드로이드의 versionCode 이고, 이미 깔린 값보다 커야
		  기존 앱 위에 "업데이트" 로 설치된다(데이터 유지). 내릴 수는 없으니 배포할 때마다 올린다.
		-->
		<ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
	</PropertyGroup>

	<!-- Debug: 실기기 USB 디버깅용. APK로 묶고 링커를 끈다. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidLinkMode>None</AndroidLinkMode>
	</PropertyGroup>

	<!--
	  네트워크 보안 설정은 배포용(평문 전면 차단)이 기본이다.
	  Debug 일 때만 로컬 서버(127.0.0.1)용 예외가 든 파일로 바꿔 넣는다.
	  Link 로 같은 리소스 이름에 들어가므로 AndroidManifest 의 @xml/network_security_config 는 그대로 쓴다.
	  ResourcesDebug 폴더는 Resources 와 이름이 달라 기본 리소스 수집에 걸리지 않는다.
	-->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
		<AndroidResource Include="Platforms\Android\ResourcesDebug\xml\network_security_config.xml"
		                 Link="Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<!-- Release: AOT + SdkOnly 링크. Newtonsoft.Json / NLog 리플렉션 때문에 Full 링크는 쓰지 않는다. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<RunAOTCompilation>true</RunAOTCompilation>
		<AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F5BD5" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F5BD5" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\tab_*.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\brandmark.svg" BaseSize="96,96" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
		<!-- WPF 프로젝트와 동일한 MVVM 스택 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BH_SecurityCode.Api\BH_SecurityCode.Api.csproj" />
	</ItemGroup>

</Project>
