<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    디자인 시스템 (갤럭시 A35 = 384 x 832 dp 기준)
      간격 4 / 8 / 12 / 16 / 20 / 24     모서리 8(작게) / 12(입력) / 16(카드) / 20(타일) / 999(pill)
      글자 28 Display · 21 Title · 17 Headline · 15 Body · 13.5 Callout · 12 Caption · 10.5 Micro

    색은 이 파일의 스타일 안에서만 AppThemeBinding 으로 풀린다. 화면(XAML)은 스타일만 참조하고
    색을 직접 쓰지 않는다 — 그래서 라이트/다크가 한 곳에서 관리된다.
    폰트는 일부러 지정하지 않는다. 기기 기본 한글 폰트(One UI Sans / Noto Sans KR)를 써야
    한글과 영문의 굵기·자간이 어긋나지 않는다. 숫자 나열에만 monospace 를 쓴다.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  ══════════ 기본 컨트롤 ══════════  -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtBg}, Dark={StaticResource DkBg}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtSurface}, Dark={StaticResource DkSurface}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextOnAccent}, Dark={StaticResource DkTextOnAccent}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtAccentPressed}, Dark={StaticResource DkAccentPressed}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtSurfaceSunken}, Dark={StaticResource DkSurfaceSunken}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtBg}, Dark={StaticResource DkBg}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource LtSurface}, Dark={StaticResource DkSurface}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
    </Style>

    <!--  ══════════ 글자 ══════════  -->

    <Style x:Key="TextDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TextTitle" TargetType="Label">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TextHeadline" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TextBody" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="TextBodyStrong" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TextCallout" TargetType="Label">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextMuted}, Dark={StaticResource DkTextMuted}}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextMuted}, Dark={StaticResource DkTextMuted}}" />
    </Style>

    <Style x:Key="TextMicro" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="CharacterSpacing" Value="0.6" />
    </Style>

    <!--  섹션 제목  -->
    <Style x:Key="TextSection" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!--  필드 이름 (상세 화면 좌측)  -->
    <Style x:Key="TextFieldKey" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
    </Style>

    <!--  숫자 나열 (계좌번호 · 카드번호 · 보안코드)  -->
    <Style x:Key="TextMono" TargetType="Label">
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="TextMonoLarge" TargetType="Label" BasedOn="{StaticResource TextMono}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style x:Key="TextOnAccent" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextOnAccent}, Dark={StaticResource DkTextOnAccent}}" />
    </Style>

    <Style x:Key="TextAccent" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TextDanger" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtDanger}, Dark={StaticResource DkDanger}}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!--  ══════════ 면 ══════════  -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtSurface}, Dark={StaticResource DkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style x:Key="CardFlat" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardSunken" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtSurfaceSunken}, Dark={StaticResource DkSurfaceSunken}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>

    <!--  입력 필드를 감싸는 테두리  -->
    <Style x:Key="InputShell" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtSurface}, Dark={StaticResource DkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!--  둥근 배지  -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtSurfaceSunken}, Dark={StaticResource DkSurfaceSunken}}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PillAccent" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtAccentSoft}, Dark={StaticResource DkAccentSoft}}" />
    </Style>

    <Style x:Key="PillWarning" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtWarningSoft}, Dark={StaticResource DkWarningSoft}}" />
    </Style>

    <Style x:Key="PillDanger" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LtDangerSoft}, Dark={StaticResource DkDangerSoft}}" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!--  ══════════ 버튼 변형 ══════════  -->

    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtAccentSoft}, Dark={StaticResource DkAccentSoft}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="ButtonGhost" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtTextMuted}, Dark={StaticResource DkTextMuted}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LtBorder}, Dark={StaticResource DkBorder}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LtDangerSoft}, Dark={StaticResource DkDangerSoft}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LtDanger}, Dark={StaticResource DkDanger}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!--  ══════════ 아이콘 ══════════  -->

    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtText}, Dark={StaticResource DkText}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HeightRequest" Value="22" />
        <Setter Property="WidthRequest" Value="22" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="IconMuted" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
    </Style>

    <Style x:Key="IconAccent" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtAccent}, Dark={StaticResource DkAccent}}" />
    </Style>

    <Style x:Key="IconOnAccent" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtTextOnAccent}, Dark={StaticResource DkTextOnAccent}}" />
    </Style>

    <!--  목록 행의 우측 화살표  -->
    <Style x:Key="IconChevron" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LtTextSubtle}, Dark={StaticResource DkTextSubtle}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="WidthRequest" Value="16" />
    </Style>

</ResourceDictionary>
