<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:BH_SecurityCode.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True" />
    <conv:DateFormatConverter x:Key="DateFmt" />
    <conv:BytesToImageConverter x:Key="BytesToImage" />
    <conv:EnumToBoolConverter x:Key="EnumToBool" />
    <conv:CodeDisplayConverter x:Key="CodeDisplay" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:EnumDisplayConverter x:Key="EnumDisplay" />

</ResourceDictionary>
