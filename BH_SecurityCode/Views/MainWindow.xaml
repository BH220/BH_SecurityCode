<Window
    x:Class="BH_SecurityCode.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:BH_SecurityCode.Core;assembly=BH_SecurityCode.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:BH_SecurityCode.Views"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Icon="pack://application:,,,/Assets/app.ico"
    Style="{StaticResource DarkWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--  기능 단축키  -->
        <KeyBinding
            Key="Insert"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="Ins" />
        <KeyBinding
            Key="F8"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F8" />
        <KeyBinding
            Key="Delete"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="Del" />
        <!--  TODO: 복사(F7) 숨김 처리와 함께 단축키도 비활성화
        <KeyBinding
            Key="F7"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F7" />
        -->
        <KeyBinding
            Key="F5"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F5" />
        <KeyBinding
            Key="F6"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F6" />
        <!--  TODO: 엑셀(F11)/인쇄(F12) 숨김 처리와 함께 단축키도 비활성화
        <KeyBinding
            Key="F11"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F11" />
        <KeyBinding
            Key="F12"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F12" />
        -->
        <KeyBinding
            Key="F1"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F1" />
        <KeyBinding
            Key="F2"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="F2" />
        <KeyBinding
            Key="Escape"
            Command="{Binding RunFunctionCommand}"
            CommandParameter="ESC" />
        <!--  메뉴 단축키 (Ctrl + Shift + Key)  -->
        <KeyBinding
            Key="S"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.보안코드}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="B"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.통장}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="C"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.카드}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="I"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.신분증}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="X"
            Command="{Binding SelectMenuCommand}"
            CommandParameter="{x:Static core:Menus.계정}"
            Modifiers="Ctrl+Shift" />
        <!--  시스템 단축키 (Alt + Key)  -->
        <KeyBinding
            Key="R"
            Command="{Binding ExtendTimeCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="L"
            Command="{Binding LockScreenCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="O"
            Command="{Binding LogoutCommand}"
            Modifiers="Alt" />
    </Window.InputBindings>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  상단 타이틀 바  -->
            <Border
                Grid.Row="0"
                Padding="18,10"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="30"
                            Height="30"
                            Source="pack://application:,,,/Assets/Images/security_card.png" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                Style="{StaticResource TitleText}"
                                Text="BH Security Code" />
                            <TextBlock Style="{StaticResource SubtitleText}" Text="보안카드 · 통장 · 카드 · 신분증 · 계정 통합 관리" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="연장하기"
                            Command="{Binding ExtendTimeCommand}"
                            IsEnabled="{Binding IsLoggedIn}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="자동 잠금 시간 연장 (Alt + R)">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/refresh.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Text="{Binding ContinueText}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            AutomationProperties.Name="화면잠금"
                            Command="{Binding LockScreenCommand}"
                            IsEnabled="{Binding IsLoggedIn}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="화면잠금 (Alt + L)">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/lock.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="화면잠금" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="프로그램 종료"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="프로그램 종료">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/exit.png" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="프로그램 종료" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  기능 버튼 바  -->
            <Border
                Grid.Row="1"
                Padding="12,6"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  좌측: 데이터 편집 / 조회  -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="추가"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="Ins"
                            IsEnabled="{Binding Buttons.InsertEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_insert.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="추가 (Ins)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="수정"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F8"
                            IsEnabled="{Binding Buttons.UpdateEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_update.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="수정 (F8)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="삭제"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="Del"
                            IsEnabled="{Binding Buttons.DeleteEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_delete.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="삭제 (Del)" />
                            </StackPanel>
                        </Button>
                        <!--  TODO: 복사는 현재 필요 없는 기능이라 숨김 처리 (구현 시 Visibility 제거)  -->
                        <Button
                            AutomationProperties.Name="복사"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F7"
                            IsEnabled="{Binding Buttons.CopyEnabled}"
                            Style="{StaticResource ToolButton}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_copy.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="복사 (F7)" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="갱신"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F5"
                            IsEnabled="{Binding Buttons.RefreshEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_refresh.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="갱신 (F5)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="검색"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F6"
                            IsEnabled="{Binding Buttons.SearchEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_search.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="검색 (F6)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  우측 정렬: 출력 / 보기 / 닫기  -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <!--  TODO: 엑셀/인쇄는 구현 계획이 없어 숨김 처리 (기능 구현 시 Visibility 제거)  -->
                        <Button
                            AutomationProperties.Name="엑셀"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F11"
                            IsEnabled="{Binding Buttons.ExcelEnabled}"
                            Style="{StaticResource ToolButton}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_excel.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="엑셀 (F11)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="인쇄"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F12"
                            IsEnabled="{Binding Buttons.PrintEnabled}"
                            Style="{StaticResource ToolButton}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_print.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="인쇄 (F12)" />
                            </StackPanel>
                        </Button>
                        <Separator Visibility="{Binding Buttons.CodeSimpleViewVisible, Converter={StaticResource BoolToVis}}" />
                        <Button
                            AutomationProperties.Name="간편보기"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F1"
                            Style="{StaticResource ToolButton}"
                            Visibility="{Binding Buttons.CodeSimpleViewVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_view.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="간편보기 (F1)" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="상세보기"
                            Command="{Binding RunFunctionCommand}"
                            CommandParameter="F2"
                            Style="{StaticResource ToolButton}"
                            Visibility="{Binding Buttons.CodeViewVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/security_card.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="상세보기 (F2)" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <Button
                            AutomationProperties.Name="화면닫기"
                            Command="{Binding CloseViewCommand}"
                            IsEnabled="{Binding Buttons.CloseEnabled}"
                            Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/Assets/Images/btn_close.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="닫기 (ESC)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  본문: 좌측 메뉴 + 컨텐츠  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12,14"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="사용자 정보" />
                        <Border
                            Margin="0,0,0,18"
                            Padding="12"
                            Background="{StaticResource BgSurfaceBrush}"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding LoginUserText}" TextWrapping="Wrap" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding LogoutCommand}"
                                    Content="로그아웃 (Alt+O)"
                                    Style="{StaticResource LinkButton}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionText}" Text="메뉴 (Ctrl + Shift + 키)" />
                        <ItemsControl ItemsSource="{Binding Menus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.SelectMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding MenuId}"
                                        Style="{StaticResource MenuButton}"
                                        ToolTip="{Binding ShortcutText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="22"
                                                Height="22"
                                                Source="{Binding Icon}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Title}" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BgInputBrush}"
                                                CornerRadius="3">
                                                <TextBlock
                                                    FontFamily="{StaticResource MonoFont}"
                                                    FontSize="11"
                                                    Style="{StaticResource MutedText}"
                                                    Text="{Binding Shortcut}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="16">
                    <ContentControl Content="{Binding CurrentView}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasView, Converter={StaticResource InvBoolToVis}}">
                        <Image
                            Width="72"
                            Height="72"
                            Opacity="0.3"
                            Source="pack://application:,,,/Assets/Images/security_card.png" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Style="{StaticResource SubtitleText}"
                            Text="좌측 메뉴를 선택하세요" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            Style="{StaticResource SubtitleText}"
                            Text="Ctrl + Shift + S / B / C / I / X" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  상태바  -->
            <Border
                Grid.Row="3"
                Padding="14,5"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding StatusText}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,24,0"
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding UserInfoText}" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="12"
                        Style="{StaticResource MutedText}"
                        Text="{Binding NowText}" />
                </Grid>
            </Border>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
        <!--  로그인 오버레이 (로그인 전 / 화면 잠금)  -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
            <views:LoginView DataContext="{Binding Login}" />
        </Grid>
    </Grid>
</Window>
