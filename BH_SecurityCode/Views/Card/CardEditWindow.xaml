<Window x:Class="BH_SecurityCode.Views.Card.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
        xmlns:controls="clr-namespace:BH_SecurityCode.Controls"
        xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
        xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.Card"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CardEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="기본 정보">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="카드명" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             helpers:FocusExtension.IsFocused="{Binding IsNameFocused}" />

                    <TextBlock Grid.Row="1" Text="카드사" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" DisplayMemberPath="NmCode" Tag="카드사 선택" />
                        <TextBlock Grid.Column="2" Text="소유자" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" DisplayMemberPath="NmCode" Tag="소유자 선택" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="명의자" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding HolderName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" />

                    <TextBlock Grid.Row="3" Style="{StaticResource RequiredLabel}"><Run Text="카드번호" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding CardNo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             FontFamily="{StaticResource MonoFont}" />

                    <TextBlock Grid.Row="4" Text="유효기간" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:MonthPicker SelectedMonth="{Binding ExpireDate}" ToolTip="유효기간은 연·월만 입력합니다 (예: 2027-03)" />
                        <TextBlock Grid.Column="2" Style="{StaticResource RequiredLabel}" MinWidth="0"><Run Text="CVC번호" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                        <TextBox Grid.Column="3"
                                 Text="{Binding Cvc, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="4"
                                 FontFamily="{StaticResource MonoFont}" />
                    </Grid>

                    <TextBlock Grid.Row="5" Text="메모" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource MultilineTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             MinHeight="70" />
                </Grid>
            </GroupBox>

            <GroupBox Header="카드 이미지" Margin="0">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
