<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vBankBook="clr-namespace:BH_SecurityCode.Views.BankBook"
    xmlns:vBankCode="clr-namespace:BH_SecurityCode.Views.BankCode"
    xmlns:vCard="clr-namespace:BH_SecurityCode.Views.Card"
    xmlns:vIdCard="clr-namespace:BH_SecurityCode.Views.IdCard"
    xmlns:vSite="clr-namespace:BH_SecurityCode.Views.Site"
    xmlns:vmBankBook="clr-namespace:BH_SecurityCode.ViewModels.BankBook"
    xmlns:vmBankCode="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    xmlns:vmCard="clr-namespace:BH_SecurityCode.ViewModels.Card"
    xmlns:vmIdCard="clr-namespace:BH_SecurityCode.ViewModels.IdCard"
    xmlns:vmSite="clr-namespace:BH_SecurityCode.ViewModels.Site">

    <!--  메인 컨텐츠 영역: ViewModel → View 매핑  -->
    <DataTemplate DataType="{x:Type vmBankCode:BankCodeListViewModel}">
        <vBankCode:BankCodeListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmBankBook:BankBookListViewModel}">
        <vBankBook:BankBookListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmCard:CardListViewModel}">
        <vCard:CardListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmIdCard:IdCardListViewModel}">
        <vIdCard:IdCardListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmSite:SiteListViewModel}">
        <vSite:SiteListView />
    </DataTemplate>

</ResourceDictionary>
