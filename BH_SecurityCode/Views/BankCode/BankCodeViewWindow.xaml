<Window
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:local="clr-namespace:BH_SecurityCode.Views.BankCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    Title="{Binding Title}"
    Width="640"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeViewViewModel}"
    helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
    SizeToContent="Height"
    Style="{StaticResource DarkDialog}"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                MinWidth="100"
                Command="{Binding CloseCommand}"
                Content="확인"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource AccentButton}" />
        </StackPanel>

        <StackPanel>
            <!--  헤더  -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/Assets/Images/security_card.png" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding BankCodeName}" />
                    <TextBlock Style="{StaticResource SubtitleText}">
                        <Run Text="{Binding BankName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OwnerName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormatText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <local:SerialTableControl Margin="0,0,0,12" />

            <GroupBox Margin="0,0,0,12" Header="보안코드">
                <local:BankCodeGridControl DataContext="{Binding Grid}" />
            </GroupBox>

            <GroupBox Margin="0" Header="이미지">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
