<Window
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeSimpleViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:local="clr-namespace:BH_SecurityCode.Views.BankCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    Title="{Binding Title}"
    Width="600"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeSimpleViewViewModel}"
    helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
    SizeToContent="Height"
    Style="{StaticResource DarkDialog}"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <Grid Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <CheckBox
                VerticalAlignment="Center"
                Content="번호 클릭시 자동복사"
                IsChecked="{Binding AutoCopy}" />
            <Button
                MinWidth="100"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="확인"
                IsCancel="True"
                Style="{StaticResource AccentButton}" />
        </Grid>

        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/Assets/Images/security_card.png" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding BankCodeName}" />
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding BankName}" />
                </StackPanel>
            </Grid>

            <local:SerialTableControl />
            <TextBlock
                Margin="2,6,0,12"
                Style="{StaticResource SubtitleText}"
                Text="일련번호는 클릭한 자리만 표시됩니다. 코드 번호 2자리를 입력하면 다음 칸으로 자동 이동합니다." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox
                    Grid.Column="0"
                    Margin="0"
                    Header="코드보기 1">
                    <local:BankCodeNumControl DataContext="{Binding Num1}" />
                </GroupBox>
                <GroupBox
                    Grid.Column="2"
                    Margin="0"
                    Header="코드보기 2">
                    <local:BankCodeNumControl DataContext="{Binding Num2}" />
                </GroupBox>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
