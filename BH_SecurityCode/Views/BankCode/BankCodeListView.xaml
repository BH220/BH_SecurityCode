<UserControl
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeListViewModel}"
    mc:Ignorable="d">
    <!--  항목: BH_SecurityCode.Api.Model.Response.BankCodeInfo (코드 값은 CdBank/CdOwner/CdAlign enum 이름으로 표시)  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:ListPageHeader Grid.Row="0" />

        <DataGrid
            Grid.Row="1"
            helpers:DataGridBehavior.RowDoubleClickCommand="{Binding ShowSimpleViewCommand}"
            helpers:DataGridBehavior.SelectRowOnRightClick="True"
            ItemsSource="{Binding ItemsView}"
            SelectedItem="{Binding SelectedItem}">
            <!--  우클릭 메뉴: 상세보기 | 추가/수정/삭제 | 갱신  -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding ShowDetailViewCommand}"
                        Header="상세보기"
                        InputGestureText="F2" />
                    <Separator />
                    <MenuItem
                        Command="{Binding InsertCommand}"
                        Header="추가"
                        InputGestureText="Ins"
                        IsEnabled="{Binding Buttons.InsertEnabled}" />
                    <MenuItem
                        Command="{Binding UpdateCommand}"
                        Header="수정"
                        InputGestureText="F8"
                        IsEnabled="{Binding Buttons.UpdateEnabled}" />
                    <MenuItem
                        Command="{Binding DeleteCommand}"
                        Header="삭제"
                        InputGestureText="Del"
                        IsEnabled="{Binding Buttons.DeleteEnabled}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding RefreshCommand}"
                        Header="갱신"
                        InputGestureText="F5"
                        IsEnabled="{Binding Buttons.RefreshEnabled}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding owner_type}"
                    ElementStyle="{StaticResource CenterCellText}"
                    Header="소유자" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding name}"
                    Header="보안코드명" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding bank_type}"
                    ElementStyle="{StaticResource CenterCellText}"
                    Header="발급기관" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding code_qty}"
                    ElementStyle="{StaticResource CenterCellText}"
                    Header="코드수" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding code_align}"
                    ElementStyle="{StaticResource CenterCellText}"
                    Header="형태" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding note}"
                    ElementStyle="{StaticResource MutedCellText}"
                    Header="비고" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
