<Window
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:local="clr-namespace:BH_SecurityCode.Views.BankCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    Title="{Binding Title}"
    Width="1020"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeEditViewModel}"
    helpers:DialogBehavior.DialogResult="{Binding DialogResult}"
    SizeToContent="Height"
    Style="{StaticResource DarkDialog}"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <!--  하단 버튼  -->
        <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                MinWidth="110"
                Command="{Binding SaveContinueCommand}"
                Content="저장 후 계속" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding SaveCommand}"
                Content="저장"
                Style="{StaticResource AccentButton}" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding CloseCommand}"
                Content="닫기" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  좌: 기본 정보 + 이미지  -->
            <StackPanel Grid.Column="0">
                <GroupBox Header="기본 정보">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="보안카드명" /><Run Foreground="{StaticResource DangerBrush}" Text=" *" /></TextBlock>
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            helpers:FocusExtension.IsFocused="{Binding IsNameFocused}"
                            MaxLength="100"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="발급기관" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            DisplayMemberPath="NmCode"
                            ItemsSource="{Binding Banks}"
                            SelectedItem="{Binding SelectedBank}"
                            Tag="발급기관 선택" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="소유자" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            DisplayMemberPath="NmCode"
                            ItemsSource="{Binding Owners}"
                            SelectedItem="{Binding SelectedOwner}"
                            Tag="소유자 선택" />

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource FieldLabel}"
                            Text="코드순서" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            Orientation="Horizontal">
                            <RadioButton
                                Content="가로"
                                IsChecked="{Binding ViewType, Converter={StaticResource EnumToBool}, ConverterParameter=가로}"
                                Style="{StaticResource ChipRadio}" />
                            <RadioButton
                                Content="세로"
                                IsChecked="{Binding ViewType, Converter={StaticResource EnumToBool}, ConverterParameter=세로}"
                                Style="{StaticResource ChipRadio}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,6,12,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource FieldLabel}"
                            Text="총 코드 수" />
                        <ListBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding CardTypes}"
                            SelectedItem="{Binding CardType}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="Bd"
                                                    Padding="10,5"
                                                    Background="{StaticResource BgSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock
                            Grid.Row="5"
                            Style="{StaticResource FieldLabel}"
                            Text="일련번호" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            CharacterCasing="Upper"
                            FontFamily="{StaticResource MonoFont}"
                            MaxLength="10"
                            Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="6"
                            Margin="0,6,12,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource FieldLabel}"
                            Text="메모" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            MinHeight="56"
                            MaxLength="200"
                            Style="{StaticResource MultilineTextBox}"
                            Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Margin="0" Header="이미지">
                    <common:ImageGridControl DataContext="{Binding Images}" />
                </GroupBox>
            </StackPanel>

            <!--  우: 보안 카드 코드  -->
            <GroupBox
                Grid.Column="2"
                Margin="0"
                Header="보안 카드 정보">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleText}">
                        <Run Text="코드순서와 총 코드 수에 따라 번호가 배열됩니다. 각 칸에 " /><Run Text="{Binding Grid.MaxCodeLength, Mode=OneWay}" /><Run Text="자리 코드를 입력하세요." />
                    </TextBlock>
                    <local:BankCodeGridControl DataContext="{Binding Grid}" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
