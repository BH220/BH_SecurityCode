<UserControl
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeGridViewModel}"
    mc:Ignorable="d">
    <!--  DataContext: BankCodeGridViewModel (기존 ctlBankCodeGrid) - 5열 코드 격자  -->
    <!--  코드 칸: 숫자만 입력, 자릿수를 다 채우면 다음 번호 칸으로 자동 이동 (TabIndex = No 이므로 가로/세로 배치와 무관)  -->
    <ItemsControl
        helpers:NumericTextBoxBehavior.IsAdvanceScope="True"
        KeyboardNavigation.TabNavigation="Local"
        ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="5,4"
                                Background="{StaticResource BgSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        MinWidth="22"
                                        Padding="3,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="3">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Text="{Binding No}" />
                                    </Border>
                                    <TextBox
                                        Grid.Column="1"
                                        MinHeight="28"
                                        Margin="4,0,0,0"
                                        Padding="2,1"
                                        HorizontalContentAlignment="Center"
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="14"
                                        helpers:NumericTextBoxBehavior.AutoAdvance="True"
                                        helpers:NumericTextBoxBehavior.IsNumericOnly="True"
                                        MaxLength="{Binding MaxLength}"
                                        TabIndex="{Binding No}"
                                        Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource InvBoolToVis}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        MinHeight="28"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Display}"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
