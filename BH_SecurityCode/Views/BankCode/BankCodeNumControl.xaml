<UserControl
    x:Class="BH_SecurityCode.Views.BankCode.BankCodeNumControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankCode"
    d:DataContext="{d:DesignInstance Type=vm:BankCodeNumViewModel}"
    mc:Ignorable="d">
    <!--  DataContext: BankCodeNumViewModel (기존 ctlBankCodeNum)  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                MinWidth="0"
                Style="{StaticResource FieldLabel}"
                Text="코드 번호" />
            <TextBox
                Width="64"
                MinHeight="34"
                HorizontalContentAlignment="Center"
                helpers:FocusExtension.IsFocused="{Binding IsInputFocused}"
                FontFamily="{StaticResource MonoFont}"
                FontSize="16"
                MaxLength="2"
                Text="{Binding CodeNo, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            MinHeight="76"
            Margin="0,10"
            Padding="8"
            Background="{StaticResource BgInputBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowPair, Converter={StaticResource BoolToVis}}">
                    <Button
                        Padding="10,0"
                        Command="{Binding CopyCommand}"
                        CommandParameter="{Binding First}"
                        Content="{Binding First}"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="34"
                        FontWeight="Bold"
                        Style="{StaticResource ToolButton}"
                        ToolTip="클릭하여 복사" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,0"
                        Command="{Binding CopyCommand}"
                        CommandParameter="{Binding Second}"
                        Content="{Binding Second}"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="34"
                        FontWeight="Bold"
                        Style="{StaticResource ToolButton}"
                        ToolTip="클릭하여 복사" />
                </StackPanel>
                <Button
                    Padding="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding CopyCommand}"
                    CommandParameter="{Binding Third}"
                    Content="{Binding Third}"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="34"
                    FontWeight="Bold"
                    Style="{StaticResource ToolButton}"
                    ToolTip="클릭하여 복사"
                    Visibility="{Binding ShowSingle, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!--  보기 옵션: 칩 라디오 2줄 배치 ([앞2자리] [뒤2자리] / [모두보기]) - 글자 잘림 방지  -->
        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RadioButton
                Grid.Row="0"
                Grid.Column="0"
                MinWidth="88"
                Content="앞2자리"
                IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter=앞2자리만보기}"
                Style="{StaticResource ChipRadio}" />
            <RadioButton
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="88"
                Margin="0,0,0,6"
                Content="뒤2자리"
                IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter=뒤2자리만보기}"
                Style="{StaticResource ChipRadio}" />
            <RadioButton
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                MinWidth="88"
                Margin="0"
                HorizontalAlignment="Center"
                Content="모두보기"
                IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter=모두보기}"
                Style="{StaticResource ChipRadio}" />
        </Grid>
    </Grid>
</UserControl>
