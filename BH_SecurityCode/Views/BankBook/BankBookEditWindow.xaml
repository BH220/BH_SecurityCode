<Window x:Class="BH_SecurityCode.Views.BankBook.BankBookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
        xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
        xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.BankBook"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BankBookEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <GroupBox Header="기본 정보">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}"><Run Text="통장명" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             helpers:FocusExtension.IsFocused="{Binding IsNameFocused}" />

                    <TextBlock Grid.Row="1" Text="은행" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}" DisplayMemberPath="NmCode" Tag="은행 선택" />
                        <TextBlock Grid.Column="2" Text="소유자" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" DisplayMemberPath="NmCode" Tag="소유자 선택" />
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource RequiredLabel}"><Run Text="예금주" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding HolderName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" />

                    <TextBlock Grid.Row="3" Text="계좌번호" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             FontFamily="{StaticResource MonoFont}" />

                    <TextBlock Grid.Row="4" Text="개설일자" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding StartDate}" />
                        <TextBlock Grid.Column="2" Text="만기일자" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" />
                    </Grid>

                    <TextBlock Grid.Row="5" Text="메모" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource MultilineTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             MinHeight="70" />
                </Grid>
            </GroupBox>

            <GroupBox Header="통장 이미지" Margin="0">
                <common:ImageGridControl DataContext="{Binding Images}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
