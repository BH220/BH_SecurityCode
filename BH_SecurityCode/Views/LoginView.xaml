<UserControl
    x:Class="BH_SecurityCode.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1180"
    mc:Ignorable="d">
    <!--
        기존 ctlLogin 의 분위기 유지: 검은 배경 + 이진수/노트북 그래픽(원본 리소스) 을 중앙에 두고
        노트북 화면 안에 아이디/비밀번호 입력을 배치한다. 좌표는 800x606 원본 이미지 기준.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="MxScreen" Color="#CC0A2C52" />
        <SolidColorBrush x:Key="MxLine" Color="#FF3FA9F5" />
        <SolidColorBrush x:Key="MxLineBright" Color="#FF8FDBFF" />
        <SolidColorBrush x:Key="MxText" Color="#FFE9F8FF" />
        <SolidColorBrush x:Key="MxTextDim" Color="#FF8CC8F0" />
        <SolidColorBrush x:Key="MxPrimary" Color="#FF1E88E5" />
        <SolidColorBrush x:Key="MxError" Color="#FFFF9A9A" />

        <Style x:Key="MxLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MxTextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MxTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource MxScreen}" />
            <Setter Property="Foreground" Value="{StaticResource MxText}" />
            <Setter Property="BorderBrush" Value="{StaticResource MxLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource MxText}" />
            <Setter Property="SelectionBrush" Value="{StaticResource MxLine}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MxLineBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MxPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource MxScreen}" />
            <Setter Property="Foreground" Value="{StaticResource MxText}" />
            <Setter Property="BorderBrush" Value="{StaticResource MxLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource MxText}" />
            <Setter Property="SelectionBrush" Value="{StaticResource MxLine}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="PasswordChar" Value="●" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MxLineBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="MxButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Background" Value="#FF0B2E52" />
            <Setter Property="BorderBrush" Value="#FF5FC3FF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style
            x:Key="MxPrimaryButton"
            BasedOn="{StaticResource MxButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#FF2196F3" />
            <Setter Property="BorderBrush" Value="#FF9ADCFF" />
        </Style>

        <!--  우하단 설정(톱니바퀴) 아이콘 버튼  -->
        <Style x:Key="MxIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF5FA8D8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#332196F3" />
                                <Setter Property="Foreground" Value="#FF9ADCFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#552196F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF000000">
        <!--  원본 그래픽 (800x606) 을 실제 크기로 중앙 배치  -->
        <Image
            Width="800"
            Height="606"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="pack://application:,,,/Assets/Images/login_matrix.png"
            Stretch="Fill" />

        <!--  노트북 화면 영역 (이미지 좌표 272,222 ~ 524,378) 에 맞춘 캔버스. 이미지 중심 기준 (-2,-3) 오프셋  -->
        <Canvas
            Width="252"
            Height="156"
            Margin="-4,-6,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  화면 상단: 자물쇠 아이콘(이미지에 포함) 오른쪽에 제품명  -->
            <TextBlock
                Canvas.Left="58"
                Canvas.Top="12"
                Margin="0,3,0,0"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{StaticResource MxText}"
                Text="BH Security Code" />
            <TextBlock
                Canvas.Left="58"
                Canvas.Top="34"
                Margin="0,7,0,0"
                FontSize="16"
                Foreground="{StaticResource MxLine}"
                Style="{StaticResource MxLabel}"
                Text="SECURITY LOGIN" />

            <!--  ID  -->
            <TextBlock
                Canvas.Left="14"
                Canvas.Top="75"
                Margin="0,-3,0,0"
                FontSize="20"
                Style="{StaticResource MxLabel}"
                Text="ID" />
            <TextBox
                Canvas.Left="46"
                Canvas.Top="70"
                Width="192"
                Height="27"
                helpers:FocusExtension.IsFocused="{Binding IsIdFocused}"
                IsReadOnly="{Binding ReadOnly}"
                Style="{StaticResource MxTextBox}"
                Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

            <!--  PW  -->
            <TextBlock
                Canvas.Left="14"
                Canvas.Top="108"
                Margin="0,1,0,0"
                FontSize="20"
                Style="{StaticResource MxLabel}"
                Text="PW" />
            <PasswordBox
                Canvas.Left="46"
                Canvas.Top="108"
                Width="192"
                Height="27"
                helpers:FocusExtension.IsFocused="{Binding IsPasswordFocused}"
                helpers:PasswordBoxHelper.BindPassword="True"
                helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource MxPasswordBox}" />

            <!--  노트북 아래: 버튼  -->
            <Button
                Canvas.Left="22"
                Canvas.Top="190"
                Width="100"
                Command="{Binding LoginCommand}"
                Content="로그인"
                IsDefault="True"
                Style="{StaticResource MxPrimaryButton}" />
            <Button
                Canvas.Left="130"
                Canvas.Top="190"
                Width="100"
                Command="{Binding ExitCommand}"
                Content="종료"
                Style="{StaticResource MxButton}" />

            <!--  상태 / 오류 메시지  -->
            <Grid
                Canvas.Left="-74"
                Canvas.Top="232"
                Width="400">
                <Border
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    Background="#D9000000"
                    BorderBrush="#FF7A2E2E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                    <TextBlock
                        MaxWidth="370"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Foreground="#FFFFB4B4"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    Background="#D9000000"
                    BorderBrush="{StaticResource MxLine}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="12.5"
                        Foreground="{StaticResource MxText}"
                        Text="로그인 중..."
                        TextAlignment="Center" />
                </Border>
            </Grid>
        </Canvas>

        <!--  좌하단: 버전  -->
        <TextBlock
            Margin="18,0,0,14"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontFamily="{StaticResource MonoFont}"
            FontSize="11"
            Foreground="#FF3A5A78"
            Text="{Binding VersionText}" />

        <!--  우하단: 현재 서버 주소 + 설정(톱니바퀴)  -->
        <StackPanel
            Margin="0,0,12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MonoFont}"
                FontSize="11"
                Foreground="#FF3A5A78"
                Text="{Binding ServerAddressText}" />
            <Button
                AutomationProperties.Name="서버 설정"
                Command="{Binding OpenSettingsCommand}"
                Style="{StaticResource MxIconButton}"
                ToolTip="API 서버 설정">
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="18"
                    Text="&#xE713;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
