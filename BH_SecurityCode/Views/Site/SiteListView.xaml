<UserControl x:Class="BH_SecurityCode.Views.Site.SiteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
             xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
             xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.Site"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SiteListViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:ListPageHeader Grid.Row="0" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  helpers:DataGridBehavior.RowDoubleClickCommand="{Binding UpdateCommand}"
                  helpers:DataGridBehavior.SelectRowOnRightClick="True">
            <!--  우클릭 메뉴 (공통: 추가/수정/삭제 | 갱신). 화면별 추가 항목은 위쪽에 붙인다.  -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="추가" InputGestureText="Ins" Command="{Binding InsertCommand}" IsEnabled="{Binding Buttons.InsertEnabled}" />
                    <MenuItem Header="수정" InputGestureText="F8" Command="{Binding UpdateCommand}" IsEnabled="{Binding Buttons.UpdateEnabled}" />
                    <MenuItem Header="삭제" InputGestureText="Del" Command="{Binding DeleteCommand}" IsEnabled="{Binding Buttons.DeleteEnabled}" />
                    <Separator />
                    <MenuItem Header="갱신" InputGestureText="F5" Command="{Binding RefreshCommand}" IsEnabled="{Binding Buttons.RefreshEnabled}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!--  항목: AccountInfo (id = 대표 아이디, 목록에서만 내려온다)  -->
                <DataGridTextColumn Header="소유자" Binding="{Binding owner}" Width="90" ElementStyle="{StaticResource CenterCellText}" />
                <DataGridTextColumn Header="사이트명" Binding="{Binding name}" Width="1.2*" />
                <DataGridTextColumn Header="대표아이디" Binding="{Binding id}" Width="1*" />
                <DataGridTextColumn Header="주소" Binding="{Binding address}" Width="1.6*" ElementStyle="{StaticResource MutedCellText}" />
                <DataGridTextColumn Header="비고" Binding="{Binding note}" Width="*" ElementStyle="{StaticResource MutedCellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
