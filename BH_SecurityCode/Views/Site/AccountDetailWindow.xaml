<Window x:Class="BH_SecurityCode.Views.Site.AccountDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
        xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.Site"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AccountDetailViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="400"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource RequiredLabel}" MinWidth="70"><Run Text="아이디" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="100"
                     helpers:FocusExtension.IsFocused="{Binding IsIdFocused}" />

            <TextBlock Grid.Row="1" Text="비밀번호" Style="{StaticResource FieldLabel}" MinWidth="70" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="100"
                     FontFamily="{StaticResource MonoFont}" />

        </Grid>

        <TextBlock Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="확인" Style="{StaticResource AccentButton}" Command="{Binding OkCommand}" MinWidth="90" IsDefault="True" />
            <Button Content="취소" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
