<Window x:Class="BH_SecurityCode.Views.IdCard.IdCardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:BH_SecurityCode.Helpers"
        xmlns:common="clr-namespace:BH_SecurityCode.Views.Common"
        xmlns:vm="clr-namespace:BH_SecurityCode.ViewModels.IdCard"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IdCardEditViewModel}"
        Style="{StaticResource DarkDialog}"
        Title="{Binding Title}"
        Width="940"
        SizeToContent="Height"
        helpers:DialogBehavior.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="저장 후 계속" Command="{Binding SaveContinueCommand}" MinWidth="110" />
            <Button Content="저장" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90" Margin="8,0,0,0" />
            <Button Content="닫기" Command="{Binding CloseCommand}" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  좌: 기본 정보  -->
            <GroupBox Grid.Column="0" Header="기본 정보" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="종류" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="4"
                            Padding="10,5"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding IdTypeName}" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Grid.Row="1" Style="{StaticResource RequiredLabel}"><Run Text="신분증 별칭" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             helpers:FocusExtension.IsFocused="{Binding IsAliasFocused}" />

                    <TextBlock Grid.Row="2" Text="소유자" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" DisplayMemberPath="NmCode" Tag="소유자 선택" />

                    <TextBlock Grid.Row="3" Text="이름(한글)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding NameKor, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             IsEnabled="{Binding IsNameKorEnabled}" />

                    <TextBlock Grid.Row="4" Text="이름(영문)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding NameEng, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             IsEnabled="{Binding IsNameEngEnabled}" />

                    <TextBlock Grid.Row="5" Text="이름(한자)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding NameCha, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             IsEnabled="{Binding IsNameChaEnabled}" />

                    <TextBlock Grid.Row="6" Text="주민등록번호" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding IdNo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="20"
                             FontFamily="{StaticResource MonoFont}" />

                    <TextBlock Grid.Row="7" Text="여권번호" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding PassportNo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="20"
                             FontFamily="{StaticResource MonoFont}"
                             IsEnabled="{Binding IsPassportEnabled}" />

                    <TextBlock Grid.Row="8" Text="면허번호" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding LicenseNo, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             FontFamily="{StaticResource MonoFont}"
                             IsEnabled="{Binding IsLicenseEnabled}" />

                    <TextBlock Grid.Row="9" Text="발급일" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding IssueDate}" />
                        <TextBlock Grid.Column="2" Text="만료일" Style="{StaticResource FieldLabel}" MinWidth="0" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ExpireDate}" IsEnabled="{Binding IsExpireEnabled}" />
                    </Grid>

                    <TextBlock Grid.Row="10" Text="발급기관명" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="10" Grid.Column="1"
                             Text="{Binding IssueOrg, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             IsEnabled="{Binding IsIssueOrgEnabled}" />
                </Grid>
            </GroupBox>

            <!--  우: 부가 정보 + 이미지  -->
            <StackPanel Grid.Column="2">
                <GroupBox Header="부가 정보">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="주소" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                 Style="{StaticResource MultilineTextBox}"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 MinHeight="56" />

                        <TextBlock Grid.Row="1" Text="추가기재사항" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                 Style="{StaticResource MultilineTextBox}"
                                 Text="{Binding AddCondition, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 MinHeight="56" />

                        <TextBlock Grid.Row="2" Text="메모" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource MultilineTextBox}"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 MinHeight="56" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="신분증 이미지" Margin="0">
                    <common:ImageGridControl DataContext="{Binding Images}" />
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
